{
  "name": "luckyguy",
  "version": "1.1.0",
  "description": "LuckyGuy - High Performance Media Downloader, Streamer & Music Manager for Windows",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite build && electron .",
    "vite": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "electron": "electron .",
    "preview": "node scripts/preview.js",
    "preview:update": "node scripts/preview.js update",
    "preview:error": "node scripts/preview.js error",
    "preview:hud": "node scripts/preview.js hud",
    "dist": "vite build && electron-builder --win",
    "dist:portable": "vite build && electron-builder --win portable",
    "dist:installer": "vite build && electron-builder --win nsis",
    "dist:all": "vite build && electron-builder --win nsis portable"
  },
  "keywords": [
    "music",
    "downloader",
    "streamer",
    "electron",
    "windows",
    "youtube",
    "spotify",
    "jiosaavn"
  ],
  "author": "Nishant",
  "license": "MIT",
  "dependencies": {
    "hls.js": "^1.7.3",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7"
  },
  "productName": "LuckyGuy",
  "build": {
    "appId": "com.luckyguy.app",
    "productName": "LuckyGuy",
    "copyright": "Copyright © 2026 Nishant",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LuckyGuy",
      "artifactName": "LuckyGuy-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "LuckyGuy-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "nishantkumrmishra",
      "repo": "LuckyGuy"
    }
  }
}
